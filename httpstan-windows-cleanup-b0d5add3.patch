+    set MSSDK=1
+    python -m pip install "poetry~=1.8.0" "setuptools<81"
+    python scripts\build_windows.py all --compiler clang-cl
+    python -m poetry build -f wheel
+    python -m pip install dist\httpstan-4.17.0-cp312-cp312-win_amd64.whl
+
